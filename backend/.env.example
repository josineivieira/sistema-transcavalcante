APP_ENV=development
APP_NAME=Container Freight Manager
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
JWT_SECRET=change-me-too
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql+psycopg://freight:freight@postgres:5432/freightdb
REDIS_URL=redis://redis:6379/0
ENCRYPTION_KEY=change-me-encryption
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fiscal@example.com
FISCAL_DEFAULT_PROVIDER=mock
FISCAL_ENVIRONMENT=homologation
ENABLE_NFSE=true
ENABLE_CTE=true
ENABLE_MDFE=false
ALLOW_MOCK_IN_PRODUCTION=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Modulo fiscal profissional
# Use mock apenas para desenvolvimento. Em produção, configure nfse_nacional/sefaz.
FISCAL_DEFAULT_PROVIDER=mock
FISCAL_ENVIRONMENT=homologation
ALLOW_MOCK_IN_PRODUCTION=false
ENABLE_NFSE=true
ENABLE_CTE=true

# NFS-e Nacional / município habilitado
NFSE_BASE_URL=

# CT-e 4.00 - endpoints do autorizador da UF
CTE_AUTHORIZATION_URL=
CTE_STATUS_URL=
CTE_EVENT_URL=

# Certificado A1 - caminho privado no servidor, nunca no frontend/GitHub
FISCAL_CERTIFICATE_PATH=
FISCAL_CERTIFICATE_PASSWORD=
FISCAL_XML_STORAGE_PATH=./storage/fiscal/xml
FISCAL_PDF_STORAGE_PATH=./storage/fiscal/pdf
